---
import { Image } from 'astro:assets';
import photo from '../assets/photo-detouree-hero.png';
import Clouds from './Clouds.astro';
import { profile } from '../data/profile';
import type { ui } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
	lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// La phrase reste entière dans ui.ts ; seul le nom (identique partout) y est injecté.
const intro = t('hero.intro').replace('{name}', profile.name);
const photoAlt = t('hero.photoAlt').replace('{name}', profile.name);

// Apparition en fondu décalé : chaque ligne part 110 ms après la précédente.
// motion-safe: désactive l'effet si le visiteur a demandé moins d'animations.
const reveal = 'motion-safe:animate-reveal';
const button =
	'inline-flex items-center rounded-full px-5 py-3 text-[15px] font-medium transition duration-200 hover:-translate-y-0.5';
const glassButton = `${button} border border-white/90 bg-white/60 backdrop-blur-sm hover:bg-white/85`;
---

<!--
	Le ciel de jour : dégradé bleu → rose → pêche, nuages en arrière-plan.
	pt-18 / md:pt-24 laissent la place à la nav posée par-dessus.
-->
<header
	id="home"
	class="@container relative overflow-hidden bg-[linear-gradient(180deg,var(--color-sky-1)_0%,var(--color-sky-2)_34%,var(--color-sky-3)_64%,var(--color-sky-4)_86%,var(--color-sky-5)_100%)] pt-18 text-night md:pt-24"
>
	<Clouds />

	<div class="relative z-10 grid px-6 md:px-gutter xl:min-h-[600px] xl:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] xl:items-center xl:gap-6">
		<div class="flex flex-col gap-3.5 pt-8 pb-6 md:pt-12 xl:py-16">
			<p
				class:list={[
					reveal,
					'inline-flex items-center gap-2 self-start rounded-full bg-white/60 px-3.5 py-1 text-[13px]',
				]}
			>
				<span
					class="size-[7px] rounded-full bg-status shadow-[0_0_0_3px_rgba(47,148,103,.18)]"
					aria-hidden="true"
				></span>
				{t('hero.available')}
			</p>

			<h1 class="flex flex-col gap-1">
				<span
					class:list={[
						reveal,
						'text-base text-night/80 [animation-delay:110ms] md:text-lg',
					]}
				>
					{intro}
				</span>
				<span
					class:list={[
						reveal,
						'font-mono text-[34px] leading-[1.08] tracking-[-.02em] [animation-delay:220ms] md:text-[56px] xl:text-[64px]',
					]}
				>
					{t('hero.title')}
				</span>
				<span
					class:list={[
						reveal,
						'font-serif text-[42px] leading-none italic [animation-delay:220ms] md:text-[72px] xl:text-[82px]',
					]}
				>
					{t('hero.titleAccent')}
				</span>
			</h1>

			<p
				class:list={[
					reveal,
					'mt-1.5 max-w-[34ch] text-[17px] font-light [animation-delay:330ms] md:text-lg',
				]}
			>
				{t('hero.lead')}
			</p>
			<p
				class:list={[
					reveal,
					'font-mono text-[13px] text-night/65 [animation-delay:330ms]',
				]}
			>
				{profile.mainStack.join(' · ')}
			</p>

			<div
				class:list={[
					reveal,
					'mt-3.5 flex flex-wrap gap-2.5 [animation-delay:440ms]',
				]}
			>
				<a href="#projects" class={`${button} bg-night text-cream`}>
					{t('hero.cta.projects')}
				</a>
				<a href={profile.cv} class={glassButton}>
					{t('hero.cta.cv')}
				</a>
				<a href="#contact" class={glassButton}>
					{t('hero.cta.contact')}
				</a>
			</div>
		</div>

		<!-- Portrait dans un cercle, entouré d'un anneau-comète blanc (pas de halo derrière la tête). -->
		<div
			class:list={[
				reveal,
				'relative mx-auto mt-4 mb-12 size-[230px] [animation-delay:220ms] xl:my-0 xl:size-[320px]',
			]}
		>
			<div class="absolute inset-1.5 overflow-hidden rounded-full bg-cream shadow-[0_20px_40px_-18px_rgba(28,34,56,.45)]">
				<Image
					src={photo}
					alt={photoAlt}
					widths={[220, 300, 440, 600]}
					sizes="(min-width: 1280px) 300px, 220px"
					priority
					class="absolute top-6 left-1/2 w-[96%] max-w-none -translate-x-1/2 xl:top-[34px]"
				/>
			</div>

			<!--
				Anneau qui tourne lentement : une traînée blanche derrière le point lumineux.
				conic-gradient part du point (45°, en haut à droite) : transparent devant lui,
				blanc plein juste derrière. Le masque radial ne garde qu'un trait de 3px.
			-->
			<div
				class="absolute inset-0 drop-shadow-[0_0_8px_rgba(255,255,255,.7)] motion-safe:animate-spin-slow"
				aria-hidden="true"
			>
				<div class="absolute -inset-2.5 rounded-full bg-[conic-gradient(from_45deg,transparent_0%,transparent_15%,#fff_100%)] [mask:radial-gradient(farthest-side,transparent_calc(100%_-_3px),#000_calc(100%_-_2px))]"></div>
				<!-- Posé sur l'anneau à 45° : 14,6 % du côté moins le débord de l'anneau et le rayon du point. -->
				<div class="absolute top-[calc(14.6%-12.5px)] right-[calc(14.6%-12.5px)] size-[11px] rounded-full bg-white shadow-[0_0_12px_#fff]"></div>
			</div>
		</div>
	</div>
</header>
