---
import { Image } from 'astro:assets';
import { projects } from '../data/projects';
import type { ui } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
	lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!-- Coucher de soleil : la crème vire au rose puis au mauve, qui annonce la nuit du contact. -->
<section
	id="projects"
	aria-labelledby="projects-title"
	class="flex flex-col gap-9 bg-[linear-gradient(180deg,var(--color-cream)_0%,var(--color-sky-4)_30%,#d9a7b8_62%,var(--color-dusk)_100%)] px-6 pt-[72px] pb-24 text-night md:px-gutter lg:pt-[88px] lg:pb-[110px]"
>
	<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
		<h2
			id="projects-title"
			class="font-serif text-[44px] leading-none italic lg:text-[60px]"
		>
			{t('projects.title')}
		</h2>
		<p class="font-mono text-[13px] text-night/70">{t('projects.subtitle')}</p>
	</div>

	<ol class="grid grid-cols-1 gap-[18px] lg:grid-cols-3">
		{projects.map((project) => {
			const title = t(`projects.${project.id}.title`);
			return (
				<li class="flex flex-col overflow-hidden rounded-[18px] bg-white/90 transition-transform duration-300 ease-[cubic-bezier(.2,.7,.2,1)] hover:-translate-y-1.5 motion-reduce:transition-none">
					<div
						class="grid aspect-16/10 place-items-center overflow-hidden font-mono text-xs text-night/55"
						style={`background:${project.tint}`}
					>
						{project.image ? (
							<Image
								src={project.image}
								alt={title}
								widths={[400, 700, 1000]}
								sizes="(min-width: 1024px) 33vw, 100vw"
								class="size-full object-cover object-top"
							/>
						) : (
							<span>{t('projects.placeholder')}</span>
						)}
					</div>
					<div class="flex flex-1 flex-col gap-2.5 px-5 pt-[18px] pb-5">
						<h3 class="text-[19px] font-semibold">{title}</h3>
						<ul class="flex flex-wrap gap-1.5">
							{project.tags.map((tag) => (
								<li class="rounded-full bg-chip px-2.5 py-[3px] font-mono text-xs">
									{tag}
								</li>
							))}
						</ul>
						<p class="text-sm text-pretty text-ink-soft">
							{t(`projects.${project.id}.desc`)}
						</p>
						<div class="mt-auto flex gap-4 pt-1 text-sm font-semibold">
							{project.repo && (
								<a
									href={project.repo}
									target="_blank"
									rel="noreferrer"
									class="underline decoration-1 underline-offset-4 hover:decoration-2"
								>
									{t('projects.code')}
								</a>
							)}
							{project.demo && (
								<a
									href={project.demo}
									target="_blank"
									rel="noreferrer"
									class="hover:underline hover:underline-offset-4"
								>
									{t('projects.demo')} <span aria-hidden="true">↗</span>
								</a>
							)}
						</div>
					</div>
				</li>
			);
		})}
	</ol>
</section>
