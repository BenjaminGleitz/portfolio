---
import { profile } from '../data/profile';
import type { ui } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
	lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!-- Fin d'après-midi : la couleur pêche du bas du ciel se prolonge. Pas de titre visible : le libellé sert aux lecteurs d'écran. -->
<section aria-label={t('techBand.label')} class="bg-sky-5 text-night">
	<ul class="flex flex-wrap justify-center gap-x-6 gap-y-3 px-6 py-5 font-mono text-sm md:px-gutter md:text-[15px] lg:justify-between">
		{profile.techs.map((tech) => (
			<li class="text-night/70 transition-colors duration-250 before:mr-2 before:text-dusk before:content-['·'] hover:text-night">
				{tech}
			</li>
		))}
	</ul>
</section>
