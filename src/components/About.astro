---
import { skills } from '../data/skills';
import type { ui } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
	lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const chips = ['about.chip.search', 'about.chip.languages'] as const;
// Couleur de la puce de chaque ligne, dans l'ordre (reprise du ciel).
const dots = ['var(--color-sky-1)', '#b592c0', '#e0967a'];
---

<!--
	Fin d'après-midi : le pêche du bandeau se fond dans la crème.
	Mobile : texte puis compétences. Desktop (lg) : deux colonnes.
-->
<section
	id="about"
	aria-labelledby="about-title"
	class="bg-[linear-gradient(180deg,var(--color-sky-5)_0%,var(--color-cream)_22%)] px-6 py-[72px] text-night md:px-gutter lg:grid lg:grid-cols-2 lg:items-start lg:gap-12 lg:py-[88px]"
>
	<div class="flex flex-col gap-4">
		<h2
			id="about-title"
			class="font-serif text-[44px] leading-none italic lg:text-[60px]"
		>
			{t('about.title')}
		</h2>
		<p class="max-w-[58ch] text-base leading-[1.75] font-light text-pretty lg:text-[17px]">
			{t('about.p1')}
		</p>
		<p class="max-w-[58ch] text-base leading-[1.75] font-light text-pretty lg:text-[17px]">
			{t('about.p2')}
		</p>
		<ul class="mt-1.5 flex flex-wrap gap-2.5">
			{chips.map((chip) => (
				<li class="rounded-full border border-sand bg-white/70 px-4 py-2 text-[13px] text-ink-soft">
					{t(chip)}
				</li>
			))}
		</ul>
	</div>

	<!-- Deux cartes de compétences : développement et déploiement. -->
	<div class="mt-10 flex flex-col gap-3.5 lg:mt-0">
		{skills.map((group) => (
			<div class="rounded-2xl border border-sand bg-white px-5 py-[18px]">
				<h3 class="mb-2.5 font-serif text-2xl italic">
					{t(`skills.${group.id}.title`)}
				</h3>
				<ul class="flex flex-col gap-2">
					{group.items.map((item, index) => (
						<li
							class="flex items-center gap-2.5 text-[15px] text-ink-soft before:size-[7px] before:shrink-0 before:rounded-full before:bg-(--dot)"
							style={`--dot:${dots[index % dots.length]}`}
						>
							{item}
						</li>
					))}
				</ul>
			</div>
		))}
	</div>
</section>
