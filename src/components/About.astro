---
import type { ui } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
	lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Compétences affichées dans la frise, dans l'ordre.
const skills = [
	{ title: 'skills.symfony.title', desc: 'skills.symfony.desc' },
	{ title: 'skills.java.title', desc: 'skills.java.desc' },
	{ title: 'skills.db.title', desc: 'skills.db.desc' },
	{ title: 'skills.tooling.title', desc: 'skills.tooling.desc' },
] as const;

const chips = ['about.chip.search', 'about.chip.languages'] as const;
---

<!--
	Mobile : « À propos » puis la frise des compétences.
	Desktop (lg) : deux colonnes 5fr / 7fr, la frise passe à gauche.
-->
<section
	id="about"
	aria-labelledby="about-title"
	class="px-6 pt-[72px] pb-10 md:px-gutter lg:grid lg:grid-cols-[5fr_7fr] lg:items-start lg:gap-16 lg:py-[150px] xl:gap-[110px]"
>
	<div class="flex flex-col gap-5 lg:gap-7">
		<h2 id="about-title" class="text-[32px] font-medium lg:text-[52px]">
			{t('about.title')}
		</h2>
		<p class="text-[15px] leading-[1.8] font-light text-pretty text-soft lg:text-[17px] lg:leading-[1.85]">
			{t('about.p1')}
		</p>
		<p class="text-[15px] leading-[1.8] font-light text-pretty text-soft lg:text-[17px] lg:leading-[1.85]">
			{t('about.p2')}
		</p>
		<ul class="mt-1.5 flex flex-wrap gap-2.5">
			{chips.map((chip) => (
				<li class="rounded-full border border-line px-4 py-2 text-[13px] text-soft">
					{t(chip)}
				</li>
			))}
		</ul>
	</div>

	<div class="mt-12 flex flex-col gap-5 lg:order-first lg:mt-0 lg:gap-8 lg:pt-3">
		<h3 class="text-xs font-medium tracking-[.14em] text-accent uppercase lg:text-[13px]">
			{t('skills.title')}
		</h3>

		<!-- Frise : un point par compétence, relié au suivant par un trait (absent sur la dernière). -->
		<ol>
			{skills.map((skill) => (
				<li class="group grid grid-cols-[14px_1fr] gap-4 lg:grid-cols-[20px_1fr] lg:gap-5">
					<div class="flex flex-col items-center" aria-hidden="true">
						<span class="mt-[7px] size-[7px] rounded-full bg-accent lg:size-[9px]" />
						<span class="mt-1.5 w-px flex-1 bg-line group-last:hidden lg:mt-2" />
					</div>
					<div class="flex flex-col gap-1 pb-6 lg:gap-1.5 lg:pb-[34px]">
						<h4 class="text-base font-medium lg:text-lg">{t(skill.title)}</h4>
						<p class="text-sm leading-[1.55] font-light text-muted lg:text-[15px] lg:leading-[1.6]">
							{t(skill.desc)}
						</p>
					</div>
				</li>
			))}
		</ol>
	</div>
</section>
