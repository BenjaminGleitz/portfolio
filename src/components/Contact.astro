---
import { profile } from '../data/profile';
import type { ui } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
	lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Affiche une URL sans protocole, « www. » ni slash final : linkedin.com/in/…
const displayUrl = (url: string) =>
	url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

const links = [
	{
		label: t('contact.email'),
		value: profile.email,
		href: `mailto:${profile.email}`,
		icon: '→',
	},
	{
		label: 'LinkedIn',
		value: displayUrl(profile.linkedin),
		href: profile.linkedin,
		icon: '↗',
		external: true,
	},
	{
		label: 'GitHub',
		value: displayUrl(profile.github),
		href: profile.github,
		icon: '↗',
		external: true,
	},
	{
		label: t('contact.cv'),
		value: t('contact.cvLink'),
		href: profile.cv,
		icon: '↓',
		download: true,
	},
];
---

<!--
	La nuit : le mauve du coucher de soleil vire au bleu nuit, sous un ciel étoilé.
	Mobile : titre, texte puis la liste, libellé au-dessus de la valeur.
	Desktop (lg) : deux colonnes 5fr / 7fr, chaque lien sur une ligne libellé | valeur | icône.
-->
<section
	id="contact"
	aria-labelledby="contact-title"
	class="relative overflow-hidden bg-[linear-gradient(180deg,var(--color-dusk)_0%,#3a3a6e_30%,var(--color-night)_75%)] px-6 pt-20 pb-16 text-cream md:px-gutter lg:grid lg:grid-cols-[5fr_7fr] lg:gap-16 lg:pt-24 lg:pb-[72px] xl:gap-[110px]"
>
	<div
		class="stars pointer-events-none absolute inset-0 opacity-80 after:absolute after:inset-0 after:translate-x-[4%] after:translate-y-[9%] after:opacity-60 after:stars motion-safe:after:animate-twinkle"
		aria-hidden="true"
	></div>

	<div class="relative flex flex-col gap-3.5 lg:gap-[22px]">
		<h2
			id="contact-title"
			class="font-serif text-[44px] leading-none italic lg:text-[60px]"
		>
			{t('contact.title')}
		</h2>
		<p class="mb-2.5 max-w-[380px] text-base leading-[1.7] font-light text-cream/85 lg:mb-0 lg:text-[17px] lg:leading-[1.8]">
			{t('contact.text')}
		</p>
	</div>

	<ul class="relative">
		{links.map((link) => (
			<li>
				<a
					href={link.href}
					target={link.external ? '_blank' : undefined}
					rel={link.external ? 'noreferrer' : undefined}
					download={link.download}
					class="flex min-h-11 items-center justify-between border-b border-white/15 py-3.5 transition-[padding,color] duration-300 hover:text-sky-5 lg:py-5 lg:hover:pl-3 xl:grid xl:grid-cols-[140px_1fr_24px] xl:py-[26px]"
				>
					{/* À partir de xl, « contents » fait du libellé et de la valeur deux cellules de la grille. */}
					<span class="flex flex-col gap-1 xl:contents">
						<span class="font-mono text-[11px] tracking-[.08em] text-cream/60 uppercase lg:text-xs">
							{link.label}
						</span>
						<span class="text-[15px] wrap-anywhere lg:text-[17px] xl:text-[19px]">
							{link.value}
						</span>
					</span>
					<span class="lg:text-lg" aria-hidden="true">
						{link.icon}
					</span>
				</a>
			</li>
		))}
	</ul>
</section>
