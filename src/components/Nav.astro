---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { profile } from '../data/profile';
import { languages, type ui } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
	lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Ancres des sections : identiques dans les deux langues, seul le libellé est traduit.
const links = [
	{ href: '#home', key: 'nav.home' },
	{ href: '#about', key: 'nav.about' },
	{ href: '#projects', key: 'nav.projects' },
	{ href: '#contact', key: 'nav.contact' },
] as const;

const locales = Object.keys(languages) as (keyof typeof languages)[];
---

<!-- Posée par-dessus le ciel du hero, qui réserve la place en haut. -->
<div class="absolute inset-x-0 top-0 z-20 flex h-18 items-center justify-between px-6 text-night md:h-24 md:px-gutter">
	<a href="#home" class="font-mono text-[15px] font-medium md:text-base">
		{profile.name}
		<span class="text-white">.</span>
	</a>

	<!-- Sur desktop, liens et langues partagent une pilule en verre. -->
	<div class="flex items-center gap-3.5 md:gap-6 md:rounded-full md:border md:border-white/80 md:bg-white/55 md:py-1.5 md:pr-1.5 md:pl-6 md:backdrop-blur-md">
		<!-- Sur mobile, le menu passe après FR/EN (order-last) comme sur la maquette. -->
		<nav aria-label={t('nav.label')} class="order-last md:order-none">
			<!-- Le bouton est le "peer" : la liste s'affiche quand il porte aria-expanded="true". -->
			<button
				type="button"
				class="peer flex size-11 cursor-pointer flex-col items-end justify-center gap-1.5 md:hidden"
				aria-label={t('nav.menu')}
				aria-expanded="false"
				aria-controls="nav-menu"
				data-nav-toggle
			>
				<span class="block h-[1.5px] w-[22px] bg-night"></span>
				<span class="block h-[1.5px] w-[22px] bg-night"></span>
				<span class="block h-[1.5px] w-[22px] bg-night"></span>
			</button>

			<ul
				id="nav-menu"
				class="absolute inset-x-4 top-full z-10 hidden flex-col gap-6 rounded-3xl border border-white/80 bg-cream/95 px-6 py-7 text-base shadow-[0_20px_40px_-20px_rgba(28,34,56,.4)] backdrop-blur-md peer-aria-expanded:flex md:static md:flex md:flex-row md:gap-6 md:rounded-none md:border-0 md:bg-transparent md:p-0 md:text-sm md:shadow-none md:backdrop-blur-none"
			>
				{links.map((link) => (
					<li>
						<a
							href={link.href}
							class="relative pb-1 text-night/80 transition-colors after:absolute after:bottom-0 after:left-0 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-night after:transition-transform after:duration-350 after:ease-out hover:text-night hover:after:scale-x-100 focus-visible:after:scale-x-100"
						>
							{t(link.key)}
						</a>
					</li>
				))}
			</ul>
		</nav>

		<ul class="flex rounded-full border border-white/80 bg-white/55 p-[3px] text-xs font-medium backdrop-blur-md md:border-0 md:bg-transparent md:p-0 md:backdrop-blur-none">
			{locales.map((locale) => (
				<li>
					<a
						href={getRelativeLocaleUrl(locale)}
						hreflang={locale}
						lang={locale}
						aria-label={languages[locale]}
						aria-current={locale === lang ? 'page' : undefined}
						class="block rounded-full px-3 py-[5px] text-night/70 transition-colors hover:text-night aria-[current=page]:bg-night aria-[current=page]:text-cream"
					>
						{locale.toUpperCase()}
					</a>
				</li>
			))}
		</ul>
	</div>
</div>

<script>
	// Ouvre/ferme le menu mobile : on ne bascule que aria-expanded, le CSS fait le reste.
	const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
	const setOpen = (open: boolean) =>
		toggle?.setAttribute('aria-expanded', String(open));

	toggle?.addEventListener('click', () =>
		setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
	);
	// Referme après un clic sur un lien de section ou avec Échap.
	document
		.querySelectorAll('#nav-menu a')
		.forEach((link) => link.addEventListener('click', () => setOpen(false)));
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') setOpen(false);
	});
</script>
