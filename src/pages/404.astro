---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Clouds from '../components/Clouds.astro';
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';
import { useTranslations } from '../i18n/utils';

// Une seule page 404 pour tout le site : on ne sait pas quelle langue le visiteur
// cherchait, donc le message est affiché en français puis en anglais.
const fr = useTranslations('fr');
const en = useTranslations('en');
---

<Layout lang="fr" title={`404 — ${profile.name}`} noindex>
	<main
		id="main"
		class="@container relative flex min-h-screen flex-col items-center justify-center gap-8 overflow-hidden bg-[linear-gradient(180deg,var(--color-sky-1)_0%,var(--color-sky-2)_34%,var(--color-sky-3)_64%,var(--color-sky-4)_86%,var(--color-sky-5)_100%)] px-6 text-center text-night"
	>
		<Clouds />

		<p class="relative font-mono text-[80px] leading-none lg:text-[120px]">
			404<span class="text-white">.</span>
		</p>

		<div class="relative flex flex-col gap-2">
			<h1 class="font-serif text-4xl italic lg:text-5xl">
				{fr('notFound.title')}
			</h1>
			<p class="font-light text-night/80">{fr('notFound.text')}</p>
		</div>
		<div lang="en" class="relative flex flex-col gap-1">
			<p class="font-serif text-2xl text-night/70 italic">
				{en('notFound.title')}
			</p>
			<p class="text-sm font-light text-night/70">{en('notFound.text')}</p>
		</div>

		<div class="relative flex flex-wrap justify-center gap-2.5 text-[15px] font-medium">
			<a
				href={getRelativeLocaleUrl('fr')}
				class="rounded-full bg-night px-5 py-3 text-cream transition duration-200 hover:-translate-y-0.5"
			>
				{fr('notFound.back')}
			</a>
			<a
				href={getRelativeLocaleUrl('en')}
				lang="en"
				class="rounded-full border border-white/90 bg-white/60 px-5 py-3 backdrop-blur-sm transition duration-200 hover:-translate-y-0.5 hover:bg-white/85"
			>
				{en('notFound.back')}
			</a>
		</div>
	</main>
</Layout>
