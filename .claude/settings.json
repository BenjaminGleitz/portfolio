{
	"permissions": {
		"allow": [
			"Bash(npm test)",
			"Bash(npm run test)",
			"Bash(npm run lint)",
			"Bash(npm run check)",
			"Bash(npm run format)",
			"Bash(npm run format:check)",
			"Bash(npx vitest run:*)",
			"Bash(npx prettier --check:*)",
			"Bash(npx prettier --write:*)",
			"Bash(npm run build)",
			"Bash(npm run preview)",
			"Bash(astro dev --background)",
			"Bash(astro dev stop)",
			"Bash(astro dev status)",
			"Bash(astro dev logs)",
			"Bash(npm install)",
			"Bash(npm ci)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-protected-commit.mjs\""
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|MultiEdit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-after-edit.mjs\"",
						"timeout": 180
					}
				]
			}
		]
	}
}
